# Copy to .env and fill in what you have. Everything is optional: RAGuard runs without any
# keys (extractive answers, no Adaption) and tells you which capabilities are off.

# Language model: auto | anthropic | ollama | none
LLM_PROVIDER=auto
# Claude (answers, vision on page images, dataset generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Local alternative: install Ollama, then `ollama pull qwen2.5vl:3b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_VISION=true

# Adaption Adaptive Data (https://docs.adaptionlabs.ai)
ADAPTION_API_KEY=
ADAPTION_MAX_ROWS=500

# Optional: run ChromaDB as a separate server for a real outage demo
# (start it with: chroma run --path data/chroma_server --port 8000)
CHROMA_HOST=
CHROMA_PORT=8000

# Retrieval tuning
TOP_K=6
RETRY_ATTEMPTS=2
EMBED_TIMEOUT_S=3
VECTOR_TIMEOUT_S=4
REQUEST_DEADLINE_S=20
VECTOR_MIN_SIMILARITY=0.35
MIN_TERM_COVERAGE=0.5
SUFFICIENCY_MIN_SCORE=0.4
