# Copy to .env (which is gitignored) and fill in what you have.

# Which stage to run: 1 = basic RAG, 2 = multimodal, 3 = fault tolerance
RAGUARD_STAGE=1

# Gemini (default LLM) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1024
# Gemini "thinking" tokens. Stage 1 defaults to budget 0; leave empty for the stage default.
# Models that use levels instead accept GEMINI_THINKING_LEVEL=minimal|low|medium|high.
# If the model rejects the setting, RAGuard falls back (level=minimal, then model default) and reports it.
GEMINI_THINKING_BUDGET=
GEMINI_THINKING_LEVEL=

# Retrieval
TOP_K=6
CHUNK_CHARS=900
CHUNK_OVERLAP=150

# Individual feature switches override the stage defaults (1/0):
# FEATURE_OCR= FEATURE_VISUALS= FEATURE_VISION= FEATURE_VISION_PARSER=
# FEATURE_BM25= FEATURE_FALLBACKS= FEATURE_RELEVANCE_GATE= FEATURE_ANSWER_CHECKS=
# FEATURE_FAULT_INJECTION= FEATURE_EXTRAS=

# Stage 3 provider chain (default gemini,ollama). Claude is optional: add ",anthropic".
# LLM_CHAIN=gemini,ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
ANTHROPIC_API_KEY=

# Extras (Data Lab + Adaption), off by default
ADAPTION_API_KEY=
