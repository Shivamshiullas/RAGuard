# Copy the lines you need into .env (repo root or backend/). .env is git-ignored.

# LLM providers, tried in order
LLM_CHAIN=gemini,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Only set for a model confirmed to accept images, e.g. qwen2.5vl:3b
OLLAMA_VISION_MODEL=
LLM_TIMEOUT_S=25

# Admin sign-in. Change before sharing the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Retrieval and chunking
TOP_K=6
MIN_SIMILARITY=0.25
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# Router
MAX_SUBTASKS=5
TASK_CONCURRENCY=3
TASK_TIMEOUT_S=90

# Uploads
MAX_UPLOAD_MB=25
MAX_IMAGE_MB=5

# Negative-result cache TTL (seconds)
NEGATIVE_CACHE_TTL_S=604800

# Simulate outages for demos: chroma,embedding,llm,ocr,bm25,vision
FAULTS=
