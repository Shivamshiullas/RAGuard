# Copy what you need into .env (repo root or landiq/backend/). .env is git-ignored.

# LLM used only to phrase grounded RAG answers (never for decisions). Optional:
# without it, questions return the retrieved evidence (EVIDENCE_ONLY).
LLM_CHAIN=gemini,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Prediction: path to an evaluated model bundle (JSON). Empty = NOT_READY (default).
MODEL_PATH=
MODEL_MAX_AGE_DAYS=180

# Retrieval
VECTOR_ENABLED=true
LEXICAL_FALLBACK_ENABLED=true
RETRIEVAL_TOP_K=8
MIN_VECTOR_SIMILARITY=0.25

# Upload limits
MAX_PDF_MB=50
MAX_MAP_MB=100
MAX_PDF_PAGES=500
MAX_FEATURES=50000

# Orchestration budgets
AGENT_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.5
AGENT_TIMEOUT_S=120
JOB_MAX_STEPS=60
JOB_MAX_SECONDS=600
JOB_WORKERS=2

# Failure injection for demos: pdf_agent,map_agent,pdf_transient,pdf_flaky,map_transient,
# pdf_invalid_output,map_invalid_output,pdf_timeout,vector,lexical,llm,fusion
FAULTS=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
